# Never send local environment files or credentials in the repository context.
**/.env
**/.env.*
**/auth.json

# The image installs its own dependencies; omit all local dependency trees.
**/vendor
**/node_modules

# Exclude local application data, generated files, and VCS/editor metadata.
**/database/*.sqlite
**/storage/app/**
**/storage/logs/**
**/storage/framework/cache/data/**
**/storage/framework/sessions/**
**/storage/framework/views/**
**/bootstrap/cache/*.php
**/public/build
**/public/hot
**/public/storage
**/dist
**/.git
**/.vscode
**/.idea
**/.phpunit.cache
**/.phpunit.result.cache

# Backend tests and development-only repository files are not runtime inputs.
backend/tests
backend/docs
backend/README.md
backend/package.json
backend/package-lock.json
backend/vite.config.js
