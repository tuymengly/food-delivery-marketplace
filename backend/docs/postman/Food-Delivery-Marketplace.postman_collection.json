      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "auth_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "customer_email",
      "value": "customer@example.com",
      "type": "string"
    },
    {
      "key": "restaurant_email",
      "value": "restaurant@example.com",
      "type": "string"
    },
    {
      "key": "rider_email",
      "value": "rider@example.com",
      "type": "string"
    },
    {
      "key": "restaurant_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "category_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "food_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "address_id",
      "value": "1",
