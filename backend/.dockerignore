# Secrets — never send these into the build context.
.env
.env.*
!.env.example
auth.json

# Dependencies — reinstalled fresh inside the image.
/vendor
/node_modules
**/node_modules

# Local database, stale bootstrap caches, and user-generated files stay out.
/database/*.sqlite
/storage/app/*
/bootstrap/cache/*.php

# Frontend tooling — not built or run inside this image (API-only container).
package.json
package-lock.json
vite.config.js

# VCS / editor / OS noise.
.git
.gitattributes
.gitignore
.editorconfig
.vscode
.idea
.fleet
.nova
.zed
Thumbs.db
.DS_Store

# Local build artifacts / caches not needed at build time.
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
.phpunit.cache
.phpunit.result.cache

# Tests and docs — not needed in the runtime image.
/tests
/docs
README.md

Dockerfile
docker-compose*.yml
