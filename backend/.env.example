APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# On Render, set LOG_CHANNEL=stderr so logs show up in the Render log stream
# instead of a file inside the (ephemeral) container filesystem.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# --- Render + Render PostgreSQL deployment (docker/) ---
# Set these as environment variables in the Render dashboard, never in a
# committed .env file:
#   DB_CONNECTION=pgsql
#   DB_URL=<Render Postgres "Internal Database URL">   (preferred - one var)
#   # ...or, instead of DB_URL, the individual fields Render also shows you:
#   # DB_HOST=, DB_PORT=5432, DB_DATABASE=, DB_USERNAME=, DB_PASSWORD=
#   DB_SSLMODE=require
# APP_KEY must also be set on Render - generate it locally with
# `php artisan key:generate --show` and paste the value in, it is never
# generated automatically inside the container.
# RUN_MIGRATIONS=true runs `php artisan migrate --force` on container boot
# (docker/entrypoint.sh) - leave unset/false and run migrations manually
# for more control over when schema changes apply.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudinary image storage
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_SECURE=true
CLOUDINARY_PREFIX=food-delivery

# Frontend apps this backend hands sessions off to (see AuthController::user()
# token-handoff pattern already used by customer-frontend/admin-restaurant).
CUSTOMER_APP_URL=http://localhost:5174
ADMIN_APP_URL=http://localhost:5173

# Google OAuth ("Continue with Google"). Client secret must never be exposed
# to the frontend - only used server-side in GoogleAuthController.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# Bakong (NBC) KHQR payments. BAKONG_TOKEN is secret - only ever read here
# server-side (BakongService), never sent to React, never logged, never
# committed. Get it from https://api-bakong.nbc.gov.kh (Bakong Open API).
# NOTE: double-check this host against your Bakong developer dashboard -
# some docs/portals also reference bakong.nbc.org.kh.
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
BAKONG_TOKEN=
# Your platform's own Bakong account ID (e.g. someone@devb) - this is the
# receiving account embedded in every KHQR code customers scan. Not secret.
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME="Food Delivery Marketplace"
BAKONG_MERCHANT_CITY="Phnom Penh"
BAKONG_MERCHANT_CATEGORY_CODE=5999
BAKONG_CURRENCY=USD
BAKONG_KHQR_EXPIRY_MINUTES=15
BAKONG_VERIFY_TIMEOUT_SECONDS=15

# ABA PayWay primary customer payment gateway. Secrets are Laravel-only.
PAYWAY_ENV=sandbox
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_RSA_PRIVATE_KEY=
PAYWAY_CURRENCY=USD
PAYWAY_QR_IMAGE_TEMPLATE=template3_color
PAYWAY_PAYMENT_LIFETIME_MINUTES=15
PAYWAY_TIMEOUT_SECONDS=15
