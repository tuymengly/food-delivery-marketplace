APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# On Render, set LOG_CHANNEL=stderr so logs show up in the Render log stream
# instead of a file inside the (ephemeral) container filesystem.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# --- Render + Render PostgreSQL deployment (docker/) ---
# Set these as environment variables in the Render dashboard, never in a
# committed .env file:
#   DB_CONNECTION=pgsql
#   DB_URL=<Render Postgres "Internal Database URL">   (preferred - one var)
#   # ...or, instead of DB_URL, the individual fields Render also shows you:
#   # DB_HOST=, DB_PORT=5432, DB_DATABASE=, DB_USERNAME=, DB_PASSWORD=
#   DB_SSLMODE=require
# APP_KEY must also be set on Render - generate it locally with
# `php artisan key:generate --show` and paste the value in, it is never
# generated automatically inside the container.
# RUN_MIGRATIONS=true runs `php artisan migrate --force` on container boot
# (docker/entrypoint.sh) - leave unset/false and run migrations manually
# for more control over when schema changes apply.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudinary image storage
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_SECURE=true
CLOUDINARY_PREFIX=food-delivery

# Frontend apps this backend hands sessions off to (see AuthController::user()
# token-handoff pattern already used by customer-frontend/admin-restaurant).
# These also seed the default CORS allow-list and Sanctum stateful domains.
# On Render point them at the deployed frontend URLs.
CUSTOMER_APP_URL=http://localhost:5174
ADMIN_APP_URL=http://localhost:5173

# Browser origins allowed to call this API (comma separated). Leave unset and
# the CUSTOMER_APP_URL/ADMIN_APP_URL values above plus the localhost dev
# ports are used, which is what local development needs.
# On Render:
#   CORS_ALLOWED_ORIGINS=https://customer-app.onrender.com,https://admin-app.onrender.com
#   CORS_ALLOWED_ORIGINS_PATTERNS=#^https://.*\.onrender\.com$#
#   CORS_SUPPORTS_CREDENTIALS=false   # bearer tokens, no cookies
# Sanctum token lifetime in minutes; unset keeps tokens valid until logout.
#   SANCTUM_TOKEN_EXPIRATION=1440
# Only relevant if a deployment ever switches to cookie-based Sanctum SPA
# auth (this app authenticates with bearer tokens):
#   SANCTUM_STATEFUL_DOMAINS=customer-app.onrender.com,admin-app.onrender.com

# Google OAuth ("Continue with Google"). Client secret must never be exposed
# to the frontend - only used server-side in GoogleAuthController.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# KHQR payments via the direct Bakong (NBC) Open API - see BakongService.
# KHQR_BAKONG_TOKEN is a secret issued by the National Bank of Cambodia's
# Bakong Open API (https://api-bakong.nbc.gov.kh) - only ever read
# server-side, never sent to React, never logged, never committed.
# bakong_id/merchant_name/merchant_city are NOT secret - they're embedded
# directly in the KHQR code shown to customers - but this is still
# Laravel-only config.
KHQR_BAKONG_API_URL=https://api-bakong.nbc.gov.kh
KHQR_BAKONG_TOKEN=
KHQR_BAKONG_ID=
KHQR_MERCHANT_NAME="Food Delivery Marketplace"
KHQR_MERCHANT_CITY="Phnom Penh"
KHQR_MERCHANT_CATEGORY_CODE=5999
KHQR_CURRENCY=USD
KHQR_PAYMENT_LIFETIME_MINUTES=15
KHQR_TIMEOUT_SECONDS=60
